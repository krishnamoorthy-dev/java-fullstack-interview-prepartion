SQL problems
--Find items between two price range
select item from Orders where amount between 200 and 300;

-- Print first three characters
select SUBSTRING(first_name,1,3) from Customers;

-- Print records where third character matches input
select first_name from Customers where SUBSTRING(first_name, 3, 1) = 'b';

-- group values as comma separated
select GROUP_CONCAT(item) from Orders

-- get second highest aged person
select * from Customers order by age desc LIMIT 1 OFFSET 1

SELECT * FROM (
    SELECT first_name, DENSE_RANK() OVER (ORDER BY age DESC) AS age_rank
    FROM Customers
) ranked_Customers
WHERE age_rank = 2;
